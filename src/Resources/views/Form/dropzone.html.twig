{% block dropzone_widget %}
    {{ block('form_widget') }}
    <script>
        (function () {
            var dropzoneId = '{{ id|default(0) }}_dropzone';
            var formWidget = document.getElementById(dropzoneId);
            if (!formWidget) return;
            var dropzoneElement = formWidget.parentElement;
            dropzoneElement.classList.add('dropzone');
            Dropzone.autoDiscover = false;

            function initPrototype(id) {
                {% if multiple %}
                var element = document.createElement('input');
                element.type = 'hidden';
                element.name = '{{ full_name }}[dropzone][]';
                element.value = id;
                element.setAttribute('data-dropzone-file-id', id);
                dropzoneElement.appendChild(element);
                {% else %}
                var element = document.createElement('option');
                element.value = id;
                element.text = id;
                element.selected = true;
                formWidget.appendChild(element);
                {% endif %}
            }

            function removePrototype(id) {
                {% if multiple %}
                var input = dropzoneElement.querySelector('input[data-dropzone-file-id="' + id + '"]');
                if (input) input.remove();
                {% else %}
                for (var i = 0; i < formWidget.options.length; i++) {
                    if (formWidget.options[i].value == id) {
                        formWidget.remove(i);
                        break;
                    }
                }
                {% if not required %}
                formWidget.value = '';
                {% endif %}
                {% endif %}
            }

            var options = {};
            {% if maxFiles is defined and maxFiles %}
            options.maxFiles = {{ maxFiles }};
            {% endif %}
            {% if uploadHandlerMethod is defined and uploadHandlerMethod %}
            options.method = '{{ uploadHandlerMethod }}';
            {% endif %}
            {% if withCredentials is defined and withCredentials %}
            options.withCredentials = {{ withCredentials }};
            {% endif %}
            {% if thumbnailWidth is defined and thumbnailWidth %}
            options.thumbnailWidth = {{ thumbnailWidth }};
            {% endif %}
            {% if thumbnailHeight is defined and thumbnailHeight %}
            options.thumbnailHeight = {{ thumbnailHeight }};
            {% endif %}
            {% if thumbnailMethod is defined and thumbnailMethod %}
            options.thumbnailMethod = '{{ thumbnailMethod }}';
            {% endif %}
            {% if resizeWidth is defined and resizeWidth %}
            options.resizeWidth = {{ resizeWidth }};
            {% endif %}
            {% if resizeHeight is defined and resizeHeight %}
            options.resizeHeight = {{ resizeHeight }};
            {% endif %}
            {% if resizeMimeType is defined and resizeMimeType %}
            options.resizeMimeType = '{{ resizeMimeType }}';
            {% endif %}
            {% if resizeMethod is defined and resizeMethod %}
            options.resizeMethod = '{{ resizeMethod }}';
            {% endif %}
            {% if filesizeBase is defined and filesizeBase %}
            options.filesizeBase = {{ filesizeBase }};
            {% endif %}
            {% if headers is defined and headers is iterable %}
            var headerObject = {};
            {% for key, value in headers %}
            headerObject['{{ key }}'] = '{{ value }}';
            {% endfor %}
            options.headers = headerObject;
            {% endif %}
            {% if ignoreHiddenFiles is defined %}
            options.ignoreHiddenFiles = {{ ignoreHiddenFiles ? 'true' : 'false' }};
            {% endif %}
            {% if acceptedFiles is defined and acceptedFiles %}
            options.acceptedFiles = '{{ acceptedFiles }}';
            {% endif %}
            {% if autoProcessQueue is defined %}
            options.autoProcessQueue = {{ autoProcessQueue ? 'true' : 'false' }};
            {% endif %}
            {% if autoQueue is defined %}
            options.autoQueue = {{ autoQueue ? 'true' : 'false' }};
            {% endif %}
            {% if addRemoveLinks is defined %}
            options.addRemoveLinks = {{ addRemoveLinks ? 'true' : 'false' }};
            {% endif %}
            {% if previewsContainer is defined and previewsContainer %}
            options.previewsContainer = '{{ previewsContainer }}';
            {% endif %}

            new Dropzone(dropzoneElement, {
                url: '{{ path(uploadHandler) }}',
                ...options,
                init: function () {
                    var dz = this;
                    {% if files is defined and files %}
                    {% for file in files %}
                    (function () {
                        var src = '{{ attribute(file, choice_src) }}';
                        var mockFile = {
                            id: '{{ file.id }}',
                            name: '{{ file.filename }}',
                            status: Dropzone.ADDED,
                            url: src
                        };
                        {% if file.size is defined %}
                        mockFile.size = {{ file.size }};
                        {% endif %}
                        {% if file.mimetype is defined %}
                        mockFile.type = '{{ file.mimetype }}';
                        {% endif %}
                        dz.emit('addedfile', mockFile);
                        dz.emit('thumbnail', mockFile, src);
                        dz.emit('complete', mockFile);
                        dz.files.push(mockFile);
                        initPrototype('{{ file.id }}');
                    })();
                    {% endfor %}
                    {% endif %}

                    this.on('success', function (file, result) {
                        if (result && result.id) {
                            file.id = result.id;
                            initPrototype(result.id);
                        }
                    });
                },
                sending: function (file, xhr, formData) {
                    {% if formData is defined and formData is iterable %}
                    {% for key, value in formData %}
                    formData.append('{{ key }}', '{{ value }}');
                    {% endfor %}
                    {% endif %}
                    {% if formDataRaw is defined and formDataRaw is iterable %}
                    {% for key, value in formDataRaw %}
                    formData.append('{{ key }}', {{ value|raw }});
                    {% endfor %}
                    {% endif %}
                },
                removedfile: function (file) {
                    if (file.id) {
                        removePrototype(file.id);
                        {% if removeHandler is defined and removeHandler %}
                        var uri = '{{ path(removeHandler, {"id": "file_id"}) }}';
                        var removeOptions = {};
                        {% if removeHandlerMethod is defined and removeHandlerMethod %}
                        removeOptions.method = '{{ removeHandlerMethod }}';
                        {% endif %}
                        if (options.headers) {
                            removeOptions.headers = options.headers;
                        }
                        fetch(uri.replace('file_id', file.id), removeOptions);
                        {% endif %}
                    }
                    if (file.previewElement) {
                        file.previewElement.remove();
                    }
                }
            });
        })();
    </script>
{% endblock %}
